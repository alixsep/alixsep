---
import Cell from "@/components/bento/cell.astro"
import EntryList from "@/components/bento/entry-list.astro"
import GlassMark from "@/components/glass-mark.astro"
import GlassSculpture from "@/components/glass-sculpture.astro"
import PostMeta from "@/components/post-meta.astro"
import ReleaseShelf from "@/components/release-shelf.astro"
import { shelf, studio } from "@/data/music"
import { research } from "@/data/research"
import Base from "@/layouts/base.astro"
import { getPosts, getWork } from "@/lib/content"
import { heroFrame } from "@/lib/layout"
import { site, writing } from "@/site"

const work = await getWork()
const [latest, ...older] = await getPosts()
const featured = studio.flatMap(({ services }) => services.filter((service) => service.featured))
---

<Base description={site.description}>
  <section class:list={["arrive-scope", heroFrame]}>
    <GlassMark text="ALIX" class="page-title w-full" />
  </section>

  <h1 data-reveal class="shell py-10 text-center sm:py-14">
    {`The official website of ${site.fullName} (${site.nickname}), known online as ${site.name}.`}
  </h1>

  <section
    aria-label="Index"
    class="shell grid gap-3 sm:grid-cols-2 lg:auto-rows-[minmax(19rem,auto)] lg:grid-cols-12"
  >
    <Cell label="Music" href="/music/" class="lg:col-span-4 lg:row-span-2">
      <div class="relative -mx-6 aspect-square max-h-96 sm:-mx-8 sm:aspect-auto sm:max-h-none sm:min-h-96 sm:flex-1 lg:min-h-[29rem]">
        <GlassSculpture
          name="microphone"
          class="top-1/2 left-1/2 h-[110%] w-auto -translate-1/2 sm:h-[105%]"
        />
      </div>
      <ReleaseShelf releases={shelf} class="-mx-6 -mt-24 sm:-mx-8 sm:-mt-[55%]" />
      <p class="relative mt-3 text-note text-muted-foreground">
        Latest releases and the full discography.
      </p>
    </Cell>

    <Cell label="Research" href="/research/" class="lg:col-span-8">
      <div class="relative -mx-6 aspect-square max-h-96 sm:-mx-8 sm:aspect-auto sm:max-h-none sm:min-h-72 sm:flex-1 lg:absolute lg:inset-0 lg:m-0">
        <GlassSculpture
          name="magnifier"
          class="top-1/2 left-1/2 h-[115%] w-auto -translate-1/2 sm:h-[105%] lg:h-auto lg:top-auto lg:left-auto lg:-right-[17%] lg:-bottom-44 lg:w-[69%] lg:translate-none"
        />
      </div>
      <p class="relative text-headline leading-tight lg:mt-6 lg:max-w-[50%]">{research.lede}</p>
      <p class="relative mt-auto pt-8 text-note text-muted-foreground lg:max-w-[50%]">{site.now}</p>
    </Cell>

    <Cell label="Development" href="/development/" class="sm:col-span-2 lg:col-span-8">
      <div class="relative -mx-6 aspect-[3/2] max-h-96 sm:absolute sm:inset-0 sm:m-0 sm:aspect-auto sm:max-h-none">
        <GlassSculpture
          name="code"
          class="top-1/2 left-1/2 h-[140%] w-auto -translate-1/2 sm:left-auto sm:right-4 sm:h-auto sm:w-[42%] sm:translate-x-0"
        />
      </div>
      <div class="relative z-10 sm:mt-6 sm:max-w-[52%]">
        <EntryList
          entries={work.map(({ id, data }) => ({
            href: `/development/${id}/`,
            title: data.title,
            meta: data.years,
          }))}
          more={{ href: "/development/", section: "Development" }}
        />
      </div>
      <p class="relative mt-auto pt-8 text-note text-muted-foreground sm:max-w-[52%]">
        Have a project that needs a quality frontend?
      </p>
    </Cell>

    <Cell label="Tours" status="In preparation" class="lg:col-span-8">
      <div class="relative -mx-6 aspect-[5/4] max-h-96 sm:-mx-8 sm:aspect-auto sm:max-h-none sm:min-h-72 sm:flex-1 lg:absolute lg:inset-0 lg:m-0">
        <GlassSculpture
          name="plane"
          class="top-1/2 left-1/2 h-[150%] w-auto -translate-1/2 sm:h-full lg:h-auto lg:left-auto lg:-right-6 lg:w-[60%] lg:translate-x-0"
        />
      </div>
      <p class="relative text-headline leading-tight lg:mt-6 lg:max-w-[22rem]">
        Private tours of Iran, planned around your interests.
      </p>
      <div class="relative mt-auto pt-10 lg:max-w-[22rem]">
        <p class="eyebrow">Coming soon</p>
        <p class="mt-2 text-copy">Unlike any tour you have taken. Ask, and we will tell you why.</p>
      </div>
    </Cell>

    <Cell label="Studio" href="/studio/" class="lg:col-span-4 lg:row-span-2">
      <div class="relative -mx-6 aspect-square max-h-96 sm:-mx-8 sm:aspect-auto sm:max-h-none sm:min-h-72 sm:flex-1">
        <GlassSculpture
          name="headphones"
          class="top-1/2 left-1/2 h-full w-auto -translate-1/2 lg:h-auto lg:w-[92%]"
        />
      </div>
      <ul class="relative grid">
        {featured.map(({ title, short = title }) => (
          <li class="border-t border-border py-3 text-item first:border-t-0">{short}</li>
        ))}
      </ul>
      <p class="relative mt-3 text-note text-muted-foreground">
        I work on your song like it is mine, with the same care.
      </p>
    </Cell>

    <Cell
      label="Writing"
      href={latest ? `/writing/${latest.id}/` : "/writing/"}
      status={latest ? undefined : "In preparation"}
      class="sm:col-span-2 lg:col-span-8"
    >
      <div class="relative -mx-6 aspect-[4/3] max-h-96 sm:absolute sm:inset-0 sm:m-0 sm:aspect-auto sm:max-h-none">
        <GlassSculpture
          name="pen"
          class="top-1/2 left-1/2 h-[167%] w-auto -translate-1/2 sm:-top-36 sm:left-auto sm:-right-[28%] sm:h-auto sm:w-[81%] sm:translate-none"
        />
      </div>
      {latest ? (
        <div class="relative mt-auto pt-10 sm:max-w-[52%]">
          <PostMeta date={latest.data.published} body={latest.body} />
          <h3 class="mt-3 text-item leading-tight">{latest.data.title}</h3>
        </div>
      ) : (
        <div class="relative mt-auto pt-10 sm:max-w-[52%]">
          <p class="text-item leading-tight">{writing.pending}</p>
          <p class="mt-3 text-note text-muted-foreground">{writing.lede}</p>
        </div>
      )}
      {older.length > 0 && (
        <div class="relative z-10 mt-3 border-t border-border sm:max-w-[52%]">
          <EntryList
            entries={older.map(({ id, data }) => ({
              href: `/writing/${id}/`,
              title: data.title,
              meta: data.published.getFullYear(),
            }))}
            limit={1}
            more={{ href: "/writing/", section: "Writing" }}
          />
        </div>
      )}
    </Cell>

    <Cell label="Events" status="In preparation" class="lg:col-span-4">
      <div class="relative -mx-6 aspect-square max-h-96 sm:-mx-8 sm:aspect-auto sm:max-h-none sm:min-h-56 sm:flex-1">
        <GlassSculpture
          name="spotlight"
          class="top-1/2 left-1/2 h-[90%] w-auto -translate-1/2 sm:h-full"
        />
      </div>
      <p class="relative text-item leading-tight">Live shows, talks, and meetups.</p>
    </Cell>

    <Cell label="About" href="/about/" class="lg:col-span-8">
      <p class="mt-auto pt-10 text-heading leading-[1.15] tracking-[-0.01em]">
        I find peace in making things, and purpose when they make someone’s life a little easier, or
        a little happier, whether it is a tool, a song, an essay, or simply time spent together.
      </p>
    </Cell>
  </section>
</Base>
