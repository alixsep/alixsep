---
import ExternalLink from "@/components/external-link.astro"

interface Props {
  href: string
  track: string
}

const { href, track } = Astro.props
---

<ExternalLink
  href={href}
  aria-label={`Lyrics for ${track}`}
  class="group relative -m-2 -top-[0.1em] inline-grid size-8 place-items-center align-middle text-muted-foreground transition-colors duration-300 hover:text-foreground"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-3.5 overflow-visible fill-current">
    <path d="M0 6.827c0 2.164.79 4.133 2.167 5.51.393.393.786.59 1.18.983h.195c.197 0 .196-.196.196-.196-.393-.787-.588-1.77-.588-2.754 0-2.164.982-4.329 2.36-5.706V1.518c0-.197-.197-.196-.197-.196h-2.95C.789 2.896 0 4.664 0 6.827zm2.559 12.59c2.36 2.164 5.31 3.343 8.851 3.343 7.082 0 12.59-5.702 12.59-12.586 0-3.344-1.378-6.492-3.542-8.656h-.196c0-.197-.196 0-.196 0 .59 1.574.983 3.147.983 4.918 0 7.278-5.902 13.373-13.377 13.373-1.77 0-3.344-.393-4.917-.983-.197 0-.196.199-.196.395zm5.9-11.998c0 .59.395 1.178.788 1.571h.392c3.54 1.18 4.722-.193 4.722-1.767V5.056c0-.196.196-.196.196-.196h.787c.197 0 .196-.196.196-.196-.196-1.18-.784-2.358-1.571-3.342h-2.363c0-.197-.196 0-.196.196v2.95c0 1.574-1.18 2.754-2.754 2.951 0-.197-.196 0-.196 0z" />
  </svg>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 z-20 mb-1 translate-y-1 rounded-lg bg-foreground px-2 py-1 text-meta text-background opacity-0 transition duration-200 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 motion-reduce:transition-none"
  >
    Lyrics
  </span>
</ExternalLink>
