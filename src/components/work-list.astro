---
import RollText from "@/components/roll-text.astro"
import { wipe } from "@/lib/layout"

import type { CollectionEntry } from "astro:content"

interface Props {
  entries: CollectionEntry<"work">[]
}
---

<ul data-reveal-children>
  {Astro.props.entries.map(({ id, data }) => (
    <li class="border-t border-border first:border-t-0">
      <a href={`/development/${id}/`} class:list={["block py-7", wipe, "-mx-4 px-4"]}>
        <p class="eyebrow lining-nums tabular-nums">{data.years}</p>
        <RollText text={data.title} class="mt-3 block text-heading leading-tight" />
        <span class="mt-2 block max-w-[60ch] text-muted-foreground">{data.summary}</span>
      </a>
    </li>
  ))}
</ul>
