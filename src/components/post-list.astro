---
import PostMeta from "@/components/post-meta.astro"
import RollText from "@/components/roll-text.astro"
import { wipe } from "@/lib/layout"

import type { CollectionEntry } from "astro:content"

interface Props {
  posts: CollectionEntry<"writing">[]
}
---

<ul data-reveal-children>
  {Astro.props.posts.map(({ id, data, body }) => (
    <li class="border-t border-border first:border-t-0">
      <a href={`/writing/${id}/`} class:list={["block py-7", wipe, "-mx-4 px-4"]}>
        <PostMeta date={data.published} body={body} />
        <RollText text={data.title} class="mt-3 block text-heading leading-tight" />
        <span class="mt-2 block max-w-[60ch] text-muted-foreground">{data.description}</span>
      </a>
    </li>
  ))}
</ul>
